# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shared password that gates the whole app
APP_PASSWORD=change-me

# Second password, required on top of the above to add/rename/retire/delete
# machines and crew. Logging hours does not need it.
APP_ADMIN_PASSWORD=change-me-too
